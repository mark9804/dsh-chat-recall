# Copy to .env.local and fill it locally. Never paste your key into chat.
# This is API-key authentication, not an OpenAI account/OAuth login.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: send only when the selected server/model supports dimensions.
# OPENAI_EMBEDDING_DIMENSIONS=512
# The remote spike sends only the synthetic text fixtures, never files or real chats.
